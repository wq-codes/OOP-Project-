<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #0f1729;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pocketpilot.controller.BudgetController">

    <padding>
        <Insets bottom="25" left="30" right="30" top="25" />
    </padding>

    <children>

        <!-- Header row: Title + Month dropdown -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Budget" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;" text="Month:" />
                <ComboBox fx:id="monthComboBox" prefWidth="140" style="-fx-background-color: #1e293b; -fx-text-fill: white;" />
            </children>
        </HBox>

        <!-- Card 1: Monthly Budget Overview -->
        <VBox spacing="15" style="-fx-background-color: #1a2332; -fx-background-radius: 10;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>

                <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Monthly Budget Overview" />

                <HBox alignment="CENTER_LEFT" spacing="40">
                    <children>

                        <!-- Left side: 3 stacked value rows -->
                        <VBox spacing="18">
                            <children>
                                <VBox spacing="2">
                                    <children>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Budget Limit" />
                                        <Label fx:id="limitLabel" style="-fx-text-fill: #4ade80; -fx-font-size: 15px; -fx-font-weight: bold;" text="PKR 0" />
                                    </children>
                                </VBox>
                                <VBox spacing="2">
                                    <children>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Spent Amount" />
                                        <Label fx:id="spentLabel" style="-fx-text-fill: #60a5fa; -fx-font-size: 15px; -fx-font-weight: bold;" text="PKR 0" />
                                    </children>
                                </VBox>
                                <VBox spacing="2">
                                    <children>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Remaining Amount" />
                                        <Label fx:id="remainingLabel" style="-fx-text-fill: #c084fc; -fx-font-size: 15px; -fx-font-weight: bold;" text="PKR 0" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Right side: circular progress + overlay label -->
                        <VBox alignment="CENTER" spacing="8">
                            <children>
                                <StackPane>
                                    <children>
                                        <ProgressIndicator fx:id="budgetProgressIndicator" prefHeight="120" prefWidth="120" style="-fx-progress-color: #4ade80;" />
                                    </children>
                                </StackPane>
                                  <Label fx:id="percentLabel" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="0%" />
                                <Label fx:id="statusLabel" style="-fx-text-fill: #4ade80; -fx-font-size: 12px;" text="You are within your monthly budget." />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <ProgressBar fx:id="budgetProgressBar" prefHeight="10" prefWidth="500" style="-fx-accent: #4ade80;" />

            </children>
        </VBox>

        <!-- Card 2: Budget Status -->
        <VBox spacing="15" style="-fx-background-color: #1a2332; -fx-background-radius: 10;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>

                <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Budget Status" />

                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>

                        <HBox fx:id="statusBox" alignment="CENTER_LEFT" prefWidth="260" spacing="10" style="-fx-background-color: #14311f; -fx-background-radius: 8; -fx-border-color: #22c55e; -fx-border-radius: 8;">
                            <padding>
                                <Insets bottom="10" left="15" right="15" top="10" />
                            </padding>
                            <children>
                                <Label fx:id="statusMessageLabel" style="-fx-text-fill: #4ade80; -fx-font-size: 12px;" text="Great! You are within your monthly budget." wrapText="true" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox alignment="CENTER" spacing="2">
                            <children>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Limit" />
                                <Label fx:id="statusLimitLabel" style="-fx-text-fill: white; -fx-font-size: 13px;" text="PKR 0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2">
                            <children>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Spent" />
                                <Label fx:id="statusSpentLabel" style="-fx-text-fill: white; -fx-font-size: 13px;" text="PKR 0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2">
                            <children>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Remaining" />
                                <Label fx:id="statusRemainingLabel" style="-fx-text-fill: #c084fc; -fx-font-size: 13px;" text="PKR 0" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>

        <!-- Set / Update Budget button -->
        <HBox alignment="CENTER">
            <children>
                <Button fx:id="setBudgetButton" onAction="#handleSetBudget" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 10 25 10 25;" text="Set / Update Budget" />
            </children>
        </HBox>

    </children>
</VBox>
